# MealMate Lite — Docker Compose 环境变量
# 复制为 .env 并填入实际值

# PostgreSQL
DB_NAME=mealmate
DB_USER=mealmate
MEALMATE_DB_PASSWORD_FILE=/path/to/db-password-file

# App
MEALMATE_BOOTSTRAP_SECRET_FILE=/path/to/bootstrap-secret-file  # 文件内容为至少 256 位随机值
MEALMATE_MODELS_FILE=/path/to/models.json
MEALMATE_PUBLIC_DOMAIN=your-domain.example.com

# 模型供应商凭据：此文件中的变量名必须与 models.json 中启用模型的 apiKeyEnv 一致。
# 例如 provider.env 包含 OPENAI_API_KEY=your-key
MEALMATE_PROVIDER_ENV_FILE=/path/to/provider.env

# 可选：私有模型供应商的 CA 证书。两个变量必须同时设置；容器内路径使用如下值。
MEALMATE_PROVIDER_CA_FILE=
MEALMATE_PROVIDER_CA_CERT_PATH=
# 设置时：MEALMATE_PROVIDER_CA_CERT_PATH=/run/provider/provider-ca.crt
