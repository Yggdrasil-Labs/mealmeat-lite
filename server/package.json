{
  "name": "mealmate-lite-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.build.json && tsc-alias --project tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "biome check --config-path=.. src/",
    "lint:fix": "biome check --config-path=.. --write src/",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.scripts.json --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "contract:generate": "tsx scripts/contracts/compile.ts",
    "contract:check": "tsx scripts/contracts/check.ts",
    "contract:final-gate": "tsx scripts/contracts/final-gate.ts",
    "db:migration:generate": "tsx scripts/db/generate-migration.ts",
    "db:migrations:check": "tsx scripts/db/check-migrations.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.36",
    "@hono/node-server": "2.1.0",
    "ai": "7.0.64",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.32",
    "postgres": "3.4.9",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "24.13.3",
    "drizzle-kit": "0.31.10",
    "json-schema-to-ts": "3.1.1",
    "testcontainers": "12.0.4",
    "tsc-alias": "1.9.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
