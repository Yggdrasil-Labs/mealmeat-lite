{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mealmate.yggdrasil.io/contracts/v1/schemas/chat.schema.json",
  "title": "MealMate Chat Types",
  "description": "聊天相关类型定义",
  "$defs": {
    "ChatRequest": {
      "type": "object",
      "properties": {
        "chatRequestId": { "$ref": "common.schema.json#/$defs/UUID" },
        "modelId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "message": { "type": "string", "minLength": 1, "maxLength": 10000 }
      },
      "required": ["chatRequestId", "modelId", "message"],
      "additionalProperties": false
    },
    "ChatMessage": {
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string" },
        "chatRequestId": { "$ref": "common.schema.json#/$defs/UUID" },
        "createdAt": { "$ref": "common.schema.json#/$defs/Rfc3339DateTime" }
      },
      "required": ["role", "content", "chatRequestId", "createdAt"],
      "additionalProperties": false
    },
    "ChatHistoryResponse": {
      "type": "object",
      "properties": {
        "messages": {
          "type": "array",
          "items": { "$ref": "#/$defs/ChatMessage" },
          "maxItems": 40
        }
      },
      "required": ["messages"],
      "additionalProperties": false
    },
    "ToolReceipt": {
      "$comment": "mealmate:public=false",
      "type": "object",
      "properties": {
        "toolIndex": { "type": "integer", "minimum": 0 },
        "toolCallId": { "$ref": "common.schema.json#/$defs/UUID" },
        "toolName": {
          "type": "string",
          "enum": [
            "add_recipe",
            "update_recipe",
            "delete_recipe",
            "restore_recipe",
            "search_recipes",
            "batch_generate_recipes",
            "generate_weekly_plan",
            "update_plan_item"
          ]
        },
        "arguments": {},
        "argumentsHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "status": { "type": "string", "enum": ["started", "succeeded", "failed"] },
        "result": {},
        "errorCode": { "type": "string", "minLength": 1, "maxLength": 100 },
        "pendingConfirmationId": { "$ref": "common.schema.json#/$defs/UUID" }
      },
      "required": [
        "toolIndex",
        "toolCallId",
        "toolName",
        "arguments",
        "argumentsHash",
        "status"
      ],
      "oneOf": [
        {
          "properties": {
            "toolName": { "const": "add_recipe" },
            "arguments": { "$ref": "recipe.schema.json#/$defs/AddRecipeInput" },
            "result": { "$ref": "recipe.schema.json#/$defs/AddRecipeOutput" }
          }
        },
        {
          "properties": {
            "toolName": { "const": "update_recipe" },
            "arguments": { "$ref": "recipe.schema.json#/$defs/UpdateRecipeInput" },
            "result": { "$ref": "recipe.schema.json#/$defs/UpdateRecipeOutput" }
          }
        },
        {
          "properties": {
            "toolName": { "const": "delete_recipe" },
            "arguments": { "$ref": "recipe.schema.json#/$defs/DeleteRecipeInput" },
            "result": { "$ref": "recipe.schema.json#/$defs/DeleteRecipeOutput" }
          }
        },
        {
          "properties": {
            "toolName": { "const": "restore_recipe" },
            "arguments": { "$ref": "recipe.schema.json#/$defs/RestoreRecipeInput" },
            "result": { "$ref": "recipe.schema.json#/$defs/RestoreRecipeOutput" }
          }
        },
        {
          "properties": {
            "toolName": { "const": "search_recipes" },
            "arguments": { "$ref": "recipe.schema.json#/$defs/SearchRecipesInput" },
            "result": { "$ref": "recipe.schema.json#/$defs/SearchRecipesOutput" }
          }
        },
        {
          "properties": {
            "toolName": { "const": "batch_generate_recipes" },
            "arguments": { "$ref": "recipe.schema.json#/$defs/BatchGenerateRecipesInput" },
            "result": { "$ref": "recipe.schema.json#/$defs/BatchGenerateRecipesOutput" }
          }
        },
        {
          "properties": {
            "toolName": { "const": "generate_weekly_plan" },
            "arguments": { "$ref": "plan.schema.json#/$defs/GenerateWeeklyPlanInput" },
            "result": { "$ref": "plan.schema.json#/$defs/GenerateWeeklyPlanOutput" }
          }
        },
        {
          "properties": {
            "toolName": { "const": "update_plan_item" },
            "arguments": { "$ref": "plan.schema.json#/$defs/UpdatePlanItemInput" },
            "result": { "$ref": "plan.schema.json#/$defs/UpdatePlanItemOutput" }
          }
        }
      ],
      "additionalProperties": false
    },
    "ToolReceipts": {
      "$comment": "mealmate:public=false",
      "type": "array",
      "items": { "$ref": "#/$defs/ToolReceipt" }
    },
    "SseStartEvent": {
      "type": "object",
      "properties": {
        "chatRequestId": { "$ref": "common.schema.json#/$defs/UUID" },
        "replayed": { "type": "boolean" },
        "resumed": { "type": "boolean" }
      },
      "required": ["chatRequestId", "replayed", "resumed"],
      "additionalProperties": false
    },
    "SseDeltaEvent": {
      "type": "object",
      "properties": {
        "text": { "type": "string" }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "SseToolStatusEvent": {
      "type": "object",
      "properties": {
        "toolCallId": { "type": "string" },
        "toolName": { "type": "string" },
        "status": { "type": "string", "enum": ["started", "succeeded", "failed"] },
        "replayed": { "type": "boolean" }
      },
      "required": ["toolCallId", "toolName", "status"],
      "additionalProperties": false
    },
    "SseConfirmationRequiredEvent": {
      "$ref": "sync.schema.json#/$defs/ConfirmationEventDto"
    },
    "SseErrorEvent": {
      "type": "object",
      "properties": {
        "errCode": { "type": "string" },
        "errMessage": { "type": "string" },
        "retryable": { "type": "boolean" },
        "requestId": { "type": "string", "minLength": 1 }
      },
      "required": ["errCode", "errMessage", "retryable", "requestId"],
      "additionalProperties": false
    },
    "SseDoneEvent": {
      "type": "object",
      "properties": {
        "chatRequestId": { "$ref": "common.schema.json#/$defs/UUID" }
      },
      "required": ["chatRequestId"],
      "additionalProperties": false
    }
  }
}
