{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mealmate.yggdrasil.io/contracts/v1/schemas/common.schema.json",
  "title": "MealMate Common Types",
  "description": "通用类型定义",
  "$defs": {
    "UUID": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "小写 canonical UUID 格式"
    },
    "ServerVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "description": "服务端版本号，正整数十进制字符串，上限 9223372036854775807"
    },
    "Rfc3339DateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|\\+00:00)$",
      "description": "UTC RFC 3339 时间戳，仅接受 Z 或 +00:00 零 offset"
    },
    "IsoDate": {
      "type": "string",
      "format": "date",
      "description": "ISO 日期 YYYY-MM-DD"
    },
    "MondayDate": {
      "type": "string",
      "format": "date",
      "description": "必须是周一的 ISO 日期"
    },
    "MealType": {
      "type": "string",
      "enum": ["breakfast", "lunch", "dinner"],
      "description": "餐次类型"
    },
    "HealthLiveResponse": {
      "type": "object",
      "properties": {
        "status": { "const": "ok" }
      },
      "required": ["status"],
      "additionalProperties": false
    },
    "HealthReadyResponse": {
      "type": "object",
      "properties": {
        "status": { "const": "ready" }
      },
      "required": ["status"],
      "additionalProperties": false
    },
    "HealthNotReadyResponse": {
      "type": "object",
      "properties": {
        "status": { "const": "not ready" },
        "reason": { "type": "string" }
      },
      "required": ["status"],
      "additionalProperties": false
    },
    "SuccessResponse": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean", "const": true },
        "data": {}
      },
      "required": ["success", "data"],
      "additionalProperties": false
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean", "const": false },
        "errCode": { "type": "string" },
        "errMessage": { "type": "string" },
        "requestId": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": { "type": "string" },
              "reason": { "type": "string" }
            },
            "required": ["reason"],
            "additionalProperties": false
          }
        }
      },
      "required": ["success", "errCode", "errMessage", "requestId", "retryable"],
      "additionalProperties": false
    }
  }
}
