#!/usr/bin/env sh

# MealMate Lite — pre-commit hook
# Runs lint checks on staged files before committing.

set -e

ROOT=$(git rev-parse --show-toplevel)
STAGED_TS_FILES=$(git -C "$ROOT" diff --cached --name-only --diff-filter=ACM -- 'server/src/**/*.ts')

if [ -n "$STAGED_TS_FILES" ]; then
  echo "→ Running Biome check on server files..."
  cd "$ROOT/server" || exit 1
  mise exec -- corepack pnpm lint
fi

STAGED_KT_FILES=$(git -C "$ROOT" diff --cached --name-only --diff-filter=ACM -- 'app/**/*.kt')

if [ -n "$STAGED_KT_FILES" ]; then
  echo "→ Running ktlint on Kotlin files..."
  cd "$ROOT/app" || exit 1
  mise exec -- ./gradlew ktlintCheck --daemon
fi

echo "✓ Pre-commit checks passed"
